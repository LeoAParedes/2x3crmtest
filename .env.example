HOST_PORT=3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase Auth / PostgreSQL
# Public: safe to include in the browser bundle. RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private: server/Vercel secrets only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Runtime (transaction pooler, port 6543) — used by the app in production
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
# Optional: session pooler for migrate deploy on Vercel (same host, port 5432, no pgbouncer param).
# If omitted, prisma.config.ts derives it from DATABASE_URL automatically.
# Do NOT use db.PROJECT_REF.supabase.co on Vercel — build often cannot reach it (P1001).
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CASHIER_PASSWORD=

REDIS_URL=redis://redis-host:6379

# Mastra / LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# WhatsApp provider (Meta WhatsApp Cloud API) — opcional
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_API_VERSION=v21.0

# WhatsApp provider (Evolution API) — opcional
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=

# WhatsApp provider (Twilio) — producción / Meta Business Suite
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
