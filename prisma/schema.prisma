generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  cashier
}

model UserProfile {
  id          String        @id @default(cuid())
  authUserId  String        @unique @db.Uuid
  username    String        @unique
  role        UserRole
  isActive    Boolean       @default(true)
  /// ready = can open shift | on_shift = POS allowed | must_logout = post cash-cut lock
  cashierGate String        @default("ready")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sales       Sale[]
  cashSessions CashSession[]
}

model Customer {
  id                String              @id @default(cuid())
  displayName       String?
  phone             String?             @unique
  email             String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  channels          CustomerChannel[]
  conversations     Conversation[]
  account           FinanceAccount?
  orders            Order[]
  handoffTickets    HandoffTicket[]
  returnCases       ReturnCase[]
  paymentPromises   PaymentPromise[]
}

model CustomerChannel {
  id               String   @id @default(cuid())
  customerId       String
  channel          String
  externalIdentity String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([channel, externalIdentity])
  @@index([customerId, channel])
}

model Conversation {
  id               String                @id @default(cuid())
  customerId       String?
  channel          String
  sessionId        String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  customer         Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages         ConversationMessage[]
}

model ConversationMessage {
  id               String       @id @default(cuid())
  conversationId   String
  direction        String
  messageText      String       @db.Text
  intent           String?
  runMode          String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AgentAction {
  id               String   @id @default(cuid())
  conversationId   String?
  actionType       String
  payload          Json
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HandoffTicket {
  id               String   @id @default(cuid())
  customerId       String
  reason           String
  priority         String
  status           String   @default("opened")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
}

model Order {
  id               String      @id @default(cuid())
  externalOrderId  String      @unique
  customerId       String?
  status           String
  total            Decimal     @db.Decimal(10, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  customer         Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            OrderItem[]
}

model OrderItem {
  id               String        @id @default(cuid())
  orderId          String
  sku              String
  productName      String
  quantity         Int
  unitPrice        Decimal       @db.Decimal(10, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model InventoryItem {
  id               String               @id @default(cuid())
  sku              String               @unique
  productName      String
  category         String
  stock            Int
  minStock         Int                  @default(20)
  unitPrice        Decimal              @db.Decimal(10, 2)
  /// Optional IVA rate override (e.g. 0.16 = 16%). Null uses PosSettings.defaultIvaRate.
  ivaRate          Decimal?             @db.Decimal(5, 4)
  aisle            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  movements        InventoryMovement[]
  saleItems        SaleItem[]
  productSuppliers ProductSupplier[]
  purchases        Purchase[]
  lots             InventoryLot[]
}

/// One purchase receipt creates one lot with a single expiry date.
model InventoryLot {
  id                String        @id @default(cuid())
  purchaseId        String        @unique
  inventoryItemId   String
  quantityReceived  Int
  quantityRemaining Int
  /// Calendar expiry date (business day start in America/Los_Angeles, stored as UTC DateTime).
  expiresOn         DateTime
  receivedAt        DateTime      @default(now())
  /// active | exhausted | wasted
  status            String        @default("active")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  purchase          Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, expiresOn])
  @@index([status, expiresOn])
  @@index([expiresOn])
}

model InventoryMovement {
  id               String        @id @default(cuid())
  inventoryItemId  String
  movementType     String
  quantity         Int
  reason           String?
  createdAt        DateTime      @default(now())
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
}

model Supplier {
  id          String            @id @default(cuid())
  name        String
  phone       String?
  email       String?
  notes       String?
  creditLimit Decimal           @default(0) @db.Decimal(12, 2)
  openBalance Decimal           @default(0) @db.Decimal(12, 2)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductSupplier[]
  purchases   Purchase[]

  @@index([name])
  @@index([isActive, name])
}

model ProductSupplier {
  id              String        @id @default(cuid())
  inventoryItemId String
  supplierId      String
  supplierSku     String?
  lastUnitCost    Decimal?      @db.Decimal(10, 2)
  isPreferred     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, supplierId])
  @@index([supplierId])
}

model Purchase {
  id                String         @id @default(cuid())
  supplierId        String
  inventoryItemId   String
  quantity          Int
  unitCost          Decimal        @db.Decimal(10, 2)
  totalAmount       Decimal        @db.Decimal(12, 2)
  /// paid = contado | credit = cuenta por pagar
  paymentStatus     String
  soldByName        String?
  reason            String?
  expenseId         String?
  movementId        String?
  /// Lot expiry calendar date for this purchase receipt.
  expiresOn         DateTime?
  purchasedAt       DateTime       @default(now())
  createdByUsername String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  supplier          Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  lot               InventoryLot?

  @@index([supplierId, purchasedAt])
  @@index([inventoryItemId, purchasedAt])
  @@index([paymentStatus, purchasedAt])
}

model FinanceAccount {
  id               String         @id @default(cuid())
  customerId       String         @unique
  creditLimit      Decimal        @db.Decimal(10, 2)
  openBalance      Decimal        @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receivables      Receivable[]
  payments         Payment[]
  paymentPromises  PaymentPromise[]
}

model Receivable {
  id               String         @id @default(cuid())
  accountId        String
  description      String
  amount           Decimal        @db.Decimal(10, 2)
  dueDate          DateTime
  status           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  account          FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
}

model Payment {
  id               String         @id @default(cuid())
  accountId        String
  amount           Decimal        @db.Decimal(10, 2)
  method           String
  reference        String?
  createdAt        DateTime       @default(now())
  account          FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model ReturnCase {
  id               String   @id @default(cuid())
  customerId       String
  reason           String   @db.Text
  status           String   @default("opened")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
}

model PaymentPromise {
  id               String         @id @default(cuid())
  customerId       String
  financeAccountId String?
  amount           Decimal        @db.Decimal(10, 2)
  dueDate          DateTime
  status           String         @default("pending")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  financeAccount   FinanceAccount? @relation(fields: [financeAccountId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
}

model CashSession {
  id                String      @id @default(cuid())
  cashierProfileId  String
  cashierAuthUserId String      @db.Uuid
  cashierUsername   String
  status            String      @default("open")
  openingFloat      Decimal     @db.Decimal(10, 2)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  cashSalesTotal    Decimal     @db.Decimal(10, 2) @default(0)
  cardSalesTotal    Decimal     @db.Decimal(10, 2) @default(0)
  salesCount        Int         @default(0)
  expectedCash      Decimal?    @db.Decimal(10, 2)
  countedCash       Decimal?    @db.Decimal(10, 2)
  variance          Decimal?    @db.Decimal(10, 2)
  notes             String?
  cashierProfile    UserProfile @relation(fields: [cashierProfileId], references: [id], onDelete: Restrict)
  sales             Sale[]

  @@index([cashierAuthUserId, status])
  @@index([status, openedAt])
}

model Sale {
  id                String       @id @default(cuid())
  saleNumber        String       @unique
  cashierProfileId  String
  cashierAuthUserId String       @db.Uuid
  cashierUsername   String
  cashSessionId     String?
  subtotal          Decimal      @db.Decimal(10, 2)
  tax               Decimal      @db.Decimal(10, 2)
  total             Decimal      @db.Decimal(10, 2)
  paymentMethod     String
  amountReceived    Decimal?     @db.Decimal(10, 2)
  status            String       @default("completed")
  createdAt         DateTime     @default(now())
  cashierProfile    UserProfile  @relation(fields: [cashierProfileId], references: [id], onDelete: Restrict)
  cashSession       CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  items             SaleItem[]

  @@index([cashierAuthUserId, createdAt])
  @@index([cashSessionId])
}

model SaleItem {
  id              String        @id @default(cuid())
  saleId          String
  inventoryItemId String
  sku             String
  productName     String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2)
  lineTotal       Decimal       @db.Decimal(10, 2)
  lineTax         Decimal       @default(0) @db.Decimal(10, 2)
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([inventoryItemId])
}

model Expense {
  id                 String   @id @default(cuid())
  category           String
  description        String
  amount             Decimal  @db.Decimal(10, 2)
  /// fixed = recurrente/producción base | operating = corriente
  kind               String   @default("operating")
  spentAt            DateTime @default(now())
  createdByProfileId String?
  createdByUsername  String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([spentAt])
  @@index([category, spentAt])
  @@index([kind, spentAt])
}

model Promotion {
  id                String    @id @default(cuid())
  name              String
  /// porcentaje | monto_fijo | 2x1 | bundle
  type              String
  value             Decimal   @db.Decimal(10, 2)
  minPurchase       Decimal   @default(0) @db.Decimal(10, 2)
  description       String
  active            Boolean   @default(true)
  expiresAt         DateTime?
  createdByUsername String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active, expiresAt])
}

model SystemActionLog {
  id              String   @id @default(cuid())
  actorAuthUserId String?  @db.Uuid
  actorUsername   String
  actorRole       String
  action          String
  entityType      String
  entityId        String
  status          String
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([actorAuthUserId, createdAt])
  @@index([entityType, entityId])
}

model ApprovalRequest {
  id         String    @id @default(cuid())
  actionType String
  targetId   String
  reason     String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

model PosSettings {
  id                String   @id @default("default")
  showIvaOnReceipt  Boolean  @default(false)
  defaultIvaRate    Decimal  @default(0.16) @db.Decimal(5, 4)
  updatedAt         DateTime @updatedAt
}

model MastraSettings {
  id                    String   @id @default("default")
  enabled               Boolean  @default(true)
  modelId               String   @default("openai/gpt-4.1-mini")
  instructions          String   @db.Text
  allowWriteActions     Boolean  @default(true)
  allowFinancialActions Boolean  @default(true)
  maxReplyChars         Int      @default(900)
  defaultLocale         String   @default("es-MX")
  /// Whitelist of DavinciAi ERP metric tool ids (JSON string array)
  allowedErpTools       Json     @default("[\"sales_total_today\",\"sales_total_period\",\"stock_by_product_search\",\"top_product_period\",\"cash_flow_period\",\"low_stock_count\",\"expenses_total_period\",\"average_ticket_period\"]")
  updatedAt             DateTime @updatedAt
}

model ProcessedEvent {
  id          String   @id
  processedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}
